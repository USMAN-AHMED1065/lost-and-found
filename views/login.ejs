<!DOCTYPE html>
<html>
<head>
  <title>Log In</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container" style="max-width: 400px; padding-top: 60px;">
    <h2>Log In</h2>
    <form action="/auth/login" method="POST" style="display:flex; flex-direction:column; gap:12px;">
      <label>Email
        <input type="email" name="email" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <!-- <label>Password
        <input type="password" name="password" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label> -->

<label>Password
  <div class="password-field">
    <input type="password" name="password" id="password" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
    <button type="button" class="password-toggle" onclick="togglePassword('password', this)">👁️</button>
  </div>
</label>

      <button type="submit" class="btn">Log In</button>
    </form>
    <p style="margin-top:16px; font-size:14px;">Don't have an account? <a href="/auth/signup">Sign up</a></p>
  </div>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>