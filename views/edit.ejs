<!DOCTYPE html>
<html>
<head>
  <title>Edit Item</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container" style="max-width: 500px; padding-top: 40px;">
    <h2>Edit Item</h2>
    <form action="/posts/<%= post._id %>?_method=PUT" method="POST" style="display:flex; flex-direction:column; gap:12px;">
      <label>Type
        <select name="type" style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
          <option value="lost" <%= post.type === 'lost' ? 'selected' : '' %>>Lost</option>
          <option value="found" <%= post.type === 'found' ? 'selected' : '' %>>Found</option>
        </select>
      </label>
      <label>Title
        <input type="text" name="title" value="<%= post.title %>" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <label>Description
        <textarea name="description" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border); min-height:90px;"><%= post.description %></textarea>
      </label>
      <label>Location
        <input type="text" name="location" value="<%= post.location %>" style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <button type="submit" class="btn">Update</button>
    </form>
  </div>

  <%- include('partials/footer') %>
</body>
</html>