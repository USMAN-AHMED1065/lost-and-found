<!DOCTYPE html>
<html>
<head>
  <title>Report an Item</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container" style="max-width: 500px; padding-top: 40px;">
    <h2>Report a Lost or Found Item</h2>
    <form action="/posts" method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:12px;">
      <label>Type
        <select name="type" style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
          <option value="lost">Lost</option>
          <option value="found">Found</option>
        </select>
      </label>
      <label>Title
        <input type="text" name="title" placeholder="Name of item" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <label>Description
        <textarea name="description" placeholder="Give some detail about the item e.g colour" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border); min-height:90px;"></textarea>
      </label>
      <label>Location
        <input type="text" name="location" style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <label>Photo
        <input type="file" name="image" accept="image/*" capture="environment">
      </label>
      <label>Contact Phone
        <input type="tel" name="contactPhone" value="<%= user.phone %>" pattern="03[0-9]{9}" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <label>Verification Question (found items only — kept private, used to confirm the real owner)
  <input type="text" name="verificationQuestion" placeholder="e.g. What's written inside the wallet?" style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
</label>
      <label>Contact Email
        <input type="email" name="contactEmail" value="<%= user.email %>" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <button type="submit" class="btn">Submit</button>
    </form>
  </div>

  <%- include('partials/footer') %>
</body>
</html>