<!DOCTYPE html>
<html>
<head>
  <title>Sign Up</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container" style="max-width: 400px; padding-top: 60px;">
    <h2>Create an Account</h2>
    <form action="/auth/signup" method="POST" style="display:flex; flex-direction:column; gap:12px;">
      <label>Username
        <input type="text" name="username" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <!-- <label>Email
        <input type="email" name="email" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label> -->
<label>University Email (e.g. [email protected])
  <input type="email" name="email" required pattern="^[a-zA-Z0-9._-]+@student\.uet\.edu\.pk$" title="Must be a valid student.uet.edu.pk email" style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
</label>

      <label>Phone (e.g. 03001234567)
        <input type="tel" name="phone" pattern="03[0-9]{9}" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <!-- <label>Password
        <input type="password" name="password" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label> -->

      <label>Password
  <div class="password-field">
    <input type="password" name="password" id="password" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
    <button type="button" class="password-toggle" onclick="togglePassword('password', this)">👁️</button>
  </div>
</label>


      <button type="submit" class="btn">Sign Up</button>
    </form>
    <p style="margin-top:16px; font-size:14px;">Already have an account? <a href="/auth/login">Log in</a></p>
  </div>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>