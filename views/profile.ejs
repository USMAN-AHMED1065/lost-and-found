<!DOCTYPE html>
<html>
<head>
  <title>My Profile</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container" style="max-width: 500px; padding-top: 40px;">
    <h2>My Profile</h2>

    <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:16px; margin-bottom:24px;">
      <p style="margin:4px 0;">Total items posted: <strong><%= totalPosts %></strong></p>
      <p style="margin:4px 0;">Open items: <strong><%= openPosts %></strong></p>
      <p style="margin:4px 0;">Resolved items: <strong><%= resolvedPosts %></strong></p>
    </div>

    <h3>Edit Profile</h3>
    <form action="/profile/update" method="POST" style="display:flex; flex-direction:column; gap:12px; margin-bottom:32px;">
      <label>Username
        <input type="text" name="username" value="<%= user.username %>" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <label>Email
        <input type="email" name="email" value="<%= user.email %>" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <label>Phone
        <input type="tel" name="phone" value="<%= user.phone %>" pattern="03[0-9]{9}" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label>
      <button type="submit" class="btn">Update Profile</button>
    </form>

    <h3>Change Password</h3>
    <form action="/profile/change-password" method="POST" style="display:flex; flex-direction:column; gap:12px;">
      
      <!-- <label>Current Password
        <input type="password" name="currentPassword" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label> -->

      <label>Current Password
  <div class="password-field">
    <input type="password" name="currentPassword" id="currentPassword" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
    <button type="button" class="password-toggle" onclick="togglePassword('currentPassword', this)">👁️</button>
  </div>
</label>
      <!-- <label>New Password
        <input type="password" name="newPassword" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
      </label> -->

      <label>New Password
  <div class="password-field">
    <input type="password" name="newPassword" id="newPassword" required style="width:100%; padding:8px; border-radius:8px; border:1px solid var(--color-border);">
    <button type="button" class="password-toggle" onclick="togglePassword('newPassword', this)">👁️</button>
  </div>
</label>

      <button type="submit" class="btn">Change Password</button>
    </form>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>